rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Online ranking for Kenney's Race: anyone can read; anyone can add a
    // score that passes these checks; nobody can edit or delete from the web.
    match /scores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'time', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 15
        && request.resource.data.time is number
        && request.resource.data.time >= 14
        && request.resource.data.time <= 600;
      allow update, delete: if false;
    }
  }
}
