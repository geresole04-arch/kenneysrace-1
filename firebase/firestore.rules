rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Online rankings for Kenney's Race, one collection per track
    // (scores = Bosque, scores_volcan = Volcán). Anyone can read; anyone can
    // add a score that passes these checks; nobody can edit or delete.
    match /{track}/{id} {
      allow read: if track in ['scores', 'scores_volcan'];
      allow create: if track in ['scores', 'scores_volcan']
        && request.resource.data.keys().hasOnly(['name', 'time', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 15
        && request.resource.data.time is number
        && request.resource.data.time >= 14
        && request.resource.data.time <= 600;
      allow update, delete: if false;
    }
  }
}
