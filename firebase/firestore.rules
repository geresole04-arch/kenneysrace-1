rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Online rankings for Kenney Solé's Race, one collection per track:
    // scores = Bosque, scores_cielo = Cielo, scores_volcan = Volcán.
    // One document per player keeps their best time: anyone can read, create
    // a valid score, or replace their own with a FASTER one. No deletes.
    function isTrack(track) {
      return track in ['scores', 'scores_cielo', 'scores_volcan'];
    }
    function validScore() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'time', 'createdAt'])
        && d.name is string
        && d.name.size() >= 1
        && d.name.size() <= 15
        && d.time is number
        && d.time >= 14
        && d.time <= 600;
    }
    match /{track}/{id} {
      allow read: if isTrack(track);
      allow create: if isTrack(track) && validScore();
      allow update: if isTrack(track) && validScore()
        && request.resource.data.name.lower() == resource.data.name.lower()
        && request.resource.data.time < resource.data.time;
      allow delete: if false;
    }
  }
}
